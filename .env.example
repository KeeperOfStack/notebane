# ─────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Discord application ID (same page — General Information → Application ID)
APPLICATION_ID=your-application-id-here

# ─────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_LEVEL=INFO

# Log format: json (default, machine-readable) | text (human-readable dev output)
# LOG_FORMAT=json

# Override shard count (default: auto-detected by Discord)
# SHARD_COUNT=1

# Path to Netscape-format cookies file for age-restricted / geo-locked content
# YTDL_COOKIEFILE=/app/cookies.txt

# Extra FFmpeg input options (default reconnect flags are built-in)
# FFMPEG_BEFORE_OPTIONS=

# Extra FFmpeg output options
# FFMPEG_OPTIONS=

# yt-dlp is upgraded on every container start and checked every 12 h; when a
# newer one ships the bot restarts itself once nothing is playing.
# YTDL_AUTO_UPDATE=1     # 0 = never upgrade yt-dlp
# YTDL_AUTO_RESTART=1    # 0 = only log that an update is available

# ─────────────────────────────────────────────────────────
# Owner alerts + playback canary (recommended)
# ─────────────────────────────────────────────────────────
# Discord channel webhook for alerts to the bot owner. No extra bot needed:
# Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Keep it secret — anyone with the URL can post to that channel.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_RATE_LIMIT_MINUTES=60   # same alert at most once per window

# Bot 1 plays a few seconds of known videos through the real pipeline every
# N hours (and ~2 min after startup) and alerts on failure / recovery.
# CANARY_INTERVAL_HOURS=6       # 0 = disable
# CANARY_URLS=https://www.youtube.com/watch?v=jNQXAC9IVRw,https://www.youtube.com/watch?v=dQw4w9WgXcQ
# CANARY_FAIL_HEALTH=0          # 1 = /health returns 503 while the canary fails

# Prometheus metrics port (omit or leave blank to disable)
# METRICS_PORT=9090
