# Direct dependencies (human-edited). The Docker image installs the hash-pinned
# requirements.txt compiled from this file. After editing, regenerate it:
#
#   docker run --rm -v "$PWD":/w -w /w python:3.12-alpine sh -c \
#     "apk add -q gcc musl-dev libffi-dev && pip install -q pip-tools && \
#      pip-compile --generate-hashes --allow-unsafe --strip-extras \
#                  --output-file=requirements.txt requirements.in"
#
# Dependabot opens weekly PRs that bump these and regenerate requirements.txt.
# yt-dlp is NOT here on purpose — see requirements-ytdlp.txt.

discord.py[voice]==2.7.1
PyNaCl==1.5.0
# DAVE (Discord E2EE voice). discord.py 2.7.1 allows davey>=0.1.0, but with
# davey 0.2.0 the session never reports `ready`, so discord.py sends audio
# unencrypted and Discord clients drop it (bot shows as speaking, no sound).
# Re-test before bumping: play a track and check for the "DAVE not ready" warning.
davey==0.1.7

